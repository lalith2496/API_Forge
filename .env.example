# Copy to .env and fill in your values. Never commit .env to version control.

# --- LLM (pick one) ---

# Gemini LLM provider (default in UI)
GEMINI_API_KEY=your_gemini_api_key_here

# QA6 LLM: no key required — select "QA6 LLM" in the UI (corporate network / VPN)

# Optional: restrict in-browser test runner to these hostnames (comma-separated)
# ALLOWED_HOSTS=qa6-api2.sprinklr.com,qa6-api2-bdi.sprinklr.com
